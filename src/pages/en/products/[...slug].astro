---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/layout/Navbar.astro';
import Footer from '../../../components/layout/Footer.astro';
import Button from '../../../components/ui/Button.astro';
import ImagePlaceholder from '../../../components/ui/ImagePlaceholder.astro';
import { SITE } from '../../../consts';
import translations from '../../../i18n/en.json';
import { localePath } from '../../../utils/i18n';
import { imageWidths } from '../../../utils/images';
import { breadcrumbNode, graph, productNode } from '../../../utils/structured-data';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const translatedSlugs = new Set(
    products.filter(({ id }) => id.startsWith('zh/')).map(({ id }) => id.replace('zh/', ''))
  );

  return products
    .filter(({ id }) => id.startsWith('en/'))
    .map((product) => {
      const slug = product.id.replace('en/', '');
      const alternateLocales: Array<'zh' | 'en'> = translatedSlugs.has(slug)
        ? ['zh', 'en']
        : ['en'];
      return { params: { slug }, props: { product, alternateLocales } };
    });
}

const { product, alternateLocales } = Astro.props;
const { Content } = await render(product);

const t = translations;

const jsonLd = graph(
  productNode({ product, path: Astro.url.pathname }),
  breadcrumbNode([
    { name: t.nav.home, path: localePath('en') },
    { name: t.nav.products, path: localePath('en', '/products') },
    { name: product.data.name, path: Astro.url.pathname },
  ]),
);
---

<Layout title={`${product.data.name} - ${SITE.name}`} description={product.data.description} image={product.data.images[0]?.src} lang="en" alternateLocales={alternateLocales} jsonLd={jsonLd}>
  <Navbar lang="en" alternateLocales={alternateLocales} />

  <main class="min-h-screen py-16">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-8 text-sm text-muted-foreground">
        <a href={localePath('en')} class="hover:text-foreground">{t.nav.home}</a>
        <span class="mx-2">/</span>
        <a href={localePath('en', '/products')} class="hover:text-foreground">{t.nav.products}</a>
        <span class="mx-2">/</span>
        <span class="text-foreground">{product.data.name}</span>
      </nav>

      <div class="grid gap-12 lg:grid-cols-2">
        <div class="space-y-4">
          <div class="aspect-square overflow-hidden rounded-lg bg-muted">
            {product.data.images[0] ? (
              <Picture
                src={product.data.images[0]}
                alt={product.data.name}
                formats={['avif', 'webp']}
                widths={imageWidths(product.data.images[0], [480, 768, 1024])}
                sizes="(min-width: 1024px) 50vw, 100vw"
                priority
                pictureAttributes={{ class: 'block h-full w-full' }}
                class="h-full w-full object-cover"
              />
            ) : (
              <ImagePlaceholder class="h-full" />
            )}
          </div>
          {product.data.images.length > 1 && (
            <div class="grid grid-cols-4 gap-2">
              {product.data.images.slice(1).map((image) => (
                <div class="aspect-square overflow-hidden rounded-lg bg-muted">
                  <Picture
                    src={image}
                    alt={product.data.name}
                    formats={['avif', 'webp']}
                    widths={imageWidths(image, [160, 320])}
                    sizes="(min-width: 1024px) 120px, 25vw"
                    loading="lazy"
                    decoding="async"
                    pictureAttributes={{ class: 'block h-full w-full' }}
                    class="h-full w-full object-cover"
                  />
                </div>
              ))}
            </div>
          )}
        </div>

        <div>
          <span class="inline-block mb-2 text-sm font-medium text-primary">{product.data.category}</span>
          <h1 class="mb-4 text-3xl font-bold text-foreground">{product.data.name}</h1>
          <p class="mb-6 text-lg text-muted-foreground">{product.data.description}</p>

          {product.data.price && (
            <div class="mb-6">
              <span class="text-3xl font-bold text-primary">{product.data.price}</span>
            </div>
          )}

          <Button href={`mailto:${SITE.email}?subject=Inquiry: ${product.data.name}`} size="lg">
            {t.products.inquiry}
          </Button>

          {product.data.specs && Object.keys(product.data.specs).length > 0 && (
            <div class="mt-8">
              <h2 class="mb-4 text-xl font-semibold">{t.products.specs}</h2>
              <dl class="space-y-2">
                {Object.entries(product.data.specs).map(([key, value]) => (
                  <div class="flex border-b py-2">
                    <dt class="w-1/3 font-medium text-muted-foreground">{key}</dt>
                    <dd class="w-2/3">{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
        </div>
      </div>

      <div class="mt-12 prose prose-slate max-w-none">
        <Content />
      </div>
    </div>
  </main>

  <Footer lang="en" />
</Layout>
