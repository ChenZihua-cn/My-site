---
import '../styles/global.css';
import BlackHole from '../components/home/BlackHole.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Cyan's Blog — a personal space for tech, thoughts, and exploration" />
  <meta name="robots" content="noindex" />
  <title>Cyan's Blog</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --hue: 250;
      --bg: #030108;
    }

    body {
      background: var(--bg);
      color: #e8e0f0;
      font-family: 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
      cursor: default;
    }

    /* Subtle color grade + vignette over the raytraced canvas */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse at 20% 20%, oklch(28% 0.09 calc(var(--hue) + 40) / 0.15) 0%, transparent 50%),
                  radial-gradient(ellipse at 80% 80%, oklch(22% 0.07 calc(var(--hue) - 20) / 0.12) 0%, transparent 50%);
      pointer-events: none;
      z-index: 1;
    }
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse at 50% 60%, transparent 35%, oklch(8% 0.02 var(--hue) / 0.55) 80%, oklch(4% 0.01 var(--hue) / 0.8) 100%);
      pointer-events: none;
      z-index: 1;
    }

    /* ===== Space Cat ===== */
    .space-cat {
      position: fixed;
      z-index: 20;
      font-size: 2.2rem;
      animation: float-cat 7s ease-in-out infinite;
      filter: drop-shadow(0 0 14px oklch(65% 0.18 var(--hue) / 0.55));
      pointer-events: none;
      top: 12%;
      right: 9%;
      opacity: 0.85;
    }
    @keyframes float-cat {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      33% { transform: translateY(-14px) rotate(5deg); }
      66% { transform: translateY(8px) rotate(-4deg); }
    }

    /* ===== Text overlay ===== */
    .overlay {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 30;
      padding: 2rem;
      text-align: center;
      pointer-events: none;
    }
    .site-name {
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      background: linear-gradient(135deg, oklch(86% 0.1 var(--hue)), oklch(96% 0.06 calc(var(--hue) + 25)));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      opacity: 0;
      animation: fade-in-up 0.8s 0.6s ease-out forwards;
    }
    .redirect-line {
      margin-top: 0.7rem;
      font-size: 0.85rem;
      font-weight: 300;
      letter-spacing: 0.04em;
      color: oklch(80% 0.05 var(--hue) / 0.65);
      opacity: 0;
      animation: fade-in 0.6s 1.2s ease-out forwards;
    }
    .countdown-num {
      display: inline-block;
      min-width: 1.4em;
      font-weight: 600;
      color: oklch(86% 0.1 var(--hue));
      transition: color 0.3s;
    }
    .countdown-num.urgent {
      color: oklch(76% 0.18 calc(var(--hue) + 30));
      animation: pulse-urgent 0.6s ease-in-out;
    }

    @keyframes fade-in-up {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes pulse-urgent {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.25); }
    }

    @media (max-width: 480px) {
      .space-cat { font-size: 1.5rem; top: 9%; right: 6%; }
      .site-name { font-size: 1.3rem; }
      .redirect-line { font-size: 0.75rem; }
    }
  </style>
</head>
<body>

  <!-- Schwarzschild raytraced black hole (WebGL2 fullscreen shader) -->
  <BlackHole />

  <div class="space-cat" aria-hidden="true">🐱</div>

  <div class="overlay">
    <div class="site-name">Cyan's Blog</div>
    <p class="redirect-line" id="redirect-zh">正在进入站点… <span class="countdown-num" id="cd-zh">25</span> 秒</p>
    <p class="redirect-line" id="redirect-en" style="display:none;">Entering in <span class="countdown-num" id="cd-en">25</span>s…</p>
  </div>

  <script>
    (function () {
      // ── Language ──
      const lang = (navigator.language || (navigator.languages && navigator.languages[0]) || 'en').toLowerCase();
      const isZh = lang.startsWith('zh');
      const zhEl = document.getElementById('redirect-zh');
      const enEl = document.getElementById('redirect-en');
      if (isZh) { if (zhEl) zhEl.style.display = ''; }
      else { if (enEl) enEl.style.display = ''; }
      const targetPath = '/' + (isZh ? 'zh' : 'en') + '/';

      // ── Countdown: 25s ≈ one full 8-bit music loop (32 beats @ 76 BPM = 25.26s) ──
      let sec = 25;
      const cdZh = document.getElementById('cd-zh');
      const cdEn = document.getElementById('cd-en');
      const cdEl = isZh ? cdZh : cdEn;
      const tick = () => {
        sec--;
        if (cdZh) cdZh.textContent = String(sec);
        if (cdEn) cdEn.textContent = String(sec);
        if (cdEl) {
          cdEl.classList.add('urgent');
          setTimeout(() => cdEl.classList.remove('urgent'), 500);
        }
        if (sec <= 0) { window.location.href = targetPath; }
        else { setTimeout(tick, 1000); }
      };
      setTimeout(tick, 1000);

      // ═══════════════════════════════════════════
      //  8-BIT INTERSTELLAR MUSIC — Web Audio API
      // ═══════════════════════════════════════════
      (function () {
        let ctx: AudioContext | null = null;
        let masterGain: GainNode | null = null;
        let playing = true;

        function initAudio() {
          if (ctx) return;
          ctx = new AudioContext();
          masterGain = ctx.createGain();
          masterGain.gain.value = 0.14;
          masterGain.connect(ctx.destination);
          playInterstellar();
        }

        const note = (n: string): number => {
          const map: Record<string, number> = {
            'C2':65.41,'D2':73.42,'E2':82.41,'F2':87.31,'G2':98.00,'A2':110.00,'B2':123.47,
            'C3':130.81,'D3':146.83,'E3':164.81,'F3':174.61,'G3':196.00,'A3':220.00,'B3':246.94,
            'C4':261.63,'D4':293.66,'E4':329.63,'F4':349.23,'G4':392.00,'A4':440.00,'B4':493.88,
            'C5':523.25,'D5':587.33,'E5':659.25,'F5':698.46,'G5':783.99,'A5':880.00,'B5':987.77,
            'C6':1046.50
          };
          return map[n] || 440;
        };

        function square(actx: AudioContext, freq: number, start: number, dur: number, vol: number, dest: AudioNode) {
          const osc = actx.createOscillator();
          osc.type = 'square';
          osc.frequency.value = freq;
          const g = actx.createGain();
          g.gain.setValueAtTime(0, start);
          g.gain.linearRampToValueAtTime(vol, start + 0.01);
          g.gain.setValueAtTime(vol, start + dur * 0.75);
          g.gain.linearRampToValueAtTime(0, start + dur);
          osc.connect(g);
          g.connect(dest);
          osc.start(start);
          osc.stop(start + dur + 0.02);
        }

        function tri(actx: AudioContext, freq: number, start: number, dur: number, vol: number, dest: AudioNode) {
          const osc = actx.createOscillator();
          osc.type = 'triangle';
          osc.frequency.value = freq;
          const g = actx.createGain();
          g.gain.setValueAtTime(0, start);
          g.gain.linearRampToValueAtTime(vol, start + 0.02);
          g.gain.linearRampToValueAtTime(0, start + dur);
          osc.connect(g);
          g.connect(dest);
          osc.start(start);
          osc.stop(start + dur + 0.02);
        }

        function noiseTick(actx: AudioContext, start: number, vol: number, dest: AudioNode) {
          const bufferSize = Math.floor(actx.sampleRate * 0.012);
          const buffer = actx.createBuffer(1, bufferSize, actx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) {
            data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);
          }
          const src = actx.createBufferSource();
          src.buffer = buffer;
          const bp = actx.createBiquadFilter();
          bp.type = 'highpass';
          bp.frequency.value = 1800;
          const g = actx.createGain();
          g.gain.setValueAtTime(vol, start);
          g.gain.exponentialRampToValueAtTime(0.0001, start + 0.012);
          src.connect(bp);
          bp.connect(g);
          g.connect(dest);
          src.start(start);
        }

        function playInterstellar() {
          if (!ctx || !masterGain) return;

          const melodyBus = ctx.createGain();
          melodyBus.gain.value = 1.0;
          melodyBus.connect(masterGain);

          const padBus = ctx.createGain();
          padBus.gain.value = 0.65;
          padBus.connect(masterGain);

          const bpm = 76;
          const beat = 60 / bpm;
          const bar = beat * 4;

          // Interstellar-inspired melody (A minor, 8 bars)
          const melody: [string, number, number][] = [
            ['A3', 2, 0.32], ['E4', 1, 0.38], ['A4', 1, 0.42],
            ['E4', 1, 0.32], ['A4', 1, 0.38], ['B4', 1, 0.48], ['C5', 1, 0.58],
            ['B4', 2, 0.42], ['A4', 1, 0.32], ['E4', 1, 0.28],
            ['G4', 2, 0.38], ['A4', 2, 0.48],
            ['A4', 2, 0.52], ['G4', 1, 0.38], ['E4', 1, 0.32],
            ['C4', 2, 0.36], ['E4', 1, 0.28], ['G4', 1, 0.32],
            ['A4', 3, 0.48], ['E4', 1, 0.28],
            ['D4', 2, 0.32], ['E4', 2, 0.28],
            ['A3', 1.5, 0.32], ['E4', 0.5, 0.32], ['A4', 1, 0.42],
            ['E4', 1, 0.32], ['F4', 0.5, 0.38], ['G4', 0.5, 0.38],
            ['A4', 1, 0.48], ['B4', 0.5, 0.52], ['C5', 0.5, 0.52],
            ['B4', 1, 0.42], ['A4', 1, 0.38], ['G4', 1, 0.32],
            ['E4', 2, 0.28], ['D4', 1, 0.28], ['C4', 1, 0.22],
            ['A3', 1, 0.28], ['C4', 1, 0.28], ['E4', 1, 0.32],
            ['A4', 2, 0.48], ['G4', 1, 0.38],
            ['E4', 1.5, 0.28], ['D4', 0.5, 0.22],
            ['E4', 3, 0.42], ['A4', 1, 0.48],
            ['C5', 2, 0.58], ['B4', 2, 0.38],
          ];

          const pad: [string, number, number][] = [
            ['A2', bar * 4, 0.14],
            ['F2', bar * 4, 0.12],
            ['C3', bar * 4, 0.13],
            ['E2', bar * 2, 0.11], ['D2', bar * 2, 0.11],
            ['A2', bar * 4, 0.14],
            ['F2', bar * 4, 0.12],
            ['A2', bar * 4, 0.15],
            ['E2', bar * 2, 0.13], ['A2', bar * 2, 0.14],
          ];

          const loopDur = bar * 8;

          function scheduleLoop(time: number) {
            if (!ctx || !masterGain || !playing) return;

            let mTime = time;
            for (const [n, dur, vol] of melody) {
              const noteLen = dur * beat;
              square(ctx, note(n), mTime, noteLen * 0.88, vol * 0.7, melodyBus);
              mTime += noteLen;
            }

            let pTime = time;
            for (const [n, dur, vol] of pad) {
              tri(ctx, note(n), pTime, dur * 0.96, vol * 0.6, padBus);
              pTime += dur;
            }

            for (let t = 0; t < loopDur; t += beat) {
              const isBar = Math.abs(t % bar) < 0.001;
              noiseTick(ctx, time + t, isBar ? 0.085 : 0.035, masterGain);
            }

            const nextLoop = time + loopDur;
            const delay = Math.max(0.1, (nextLoop - ctx.currentTime - 0.3) * 1000);
            setTimeout(() => scheduleLoop(nextLoop), delay);
          }

          const startTime = ctx.currentTime + 0.15;
          scheduleLoop(startTime);
        }

        // Auto-start on first user interaction
        document.addEventListener('click', initAudio, { once: true });
        document.addEventListener('keydown', initAudio, { once: true });
        // Also try immediately (some browsers allow it if page was navigated to)
        try { initAudio(); } catch (_) {}
      })();
    })();
  </script>

</body>
</html>
