---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { SITE } from '../../consts';
import translations from '../../i18n/en.json';

const t = translations;
---

<Layout title={`${t.about.title} - ${SITE.name}`} lang="en">
  <Navbar lang="en" />

  <main class="min-h-screen py-16">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <h1 class="mb-8 text-4xl font-bold text-foreground">{t.about.title}</h1>

        <div class="prose prose-slate max-w-none">
          <p class="text-lg text-muted-foreground">
            Welcome to {SITE.name}! This is my personal blog for recording tech learning, project practice, and life reflections.
          </p>

          <h2 class="text-2xl font-semibold mt-8 mb-4">{t.about.aboutSite}</h2>
          <p class="text-muted-foreground">
            This blog is built with Astro 6 + Tailwind CSS, featuring bilingual support (Chinese/English)
            and light/dark theme switching. Here I share tech articles, project logs, and life notes.
          </p>

          <h2 class="text-2xl font-semibold mt-8 mb-4">{t.about.contact}</h2>
          <ul class="space-y-2 text-muted-foreground">
            <li>Email: {SITE.email}</li>
            <li>GitHub: <a href={SITE.github} class="text-primary">{SITE.github}</a></li>
          </ul>
        </div>
      </div>
    </div>
  </main>

  <Footer lang="en" />
</Layout>
