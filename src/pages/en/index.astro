---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import Hero from '../../components/home/Hero.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import PostCard from '../../components/blog/PostCard.astro';
import translations from '../../i18n/en.json';

const featuredProducts = await getCollection('products', ({ id, data }) => {
  return id.startsWith('en/') && data.featured;
}).then(products => products.slice(0, 3));

const latestPosts = await getCollection('posts', ({ id }) => {
  return id.startsWith('en/');
}).then(posts => posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6)
);

const t = translations;
---

<Layout title={`Home - ${t.home.hero.title}`} description={t.home.hero.subtitle} lang="en">
  <Navbar lang="en" />

  <main>
    <!-- Hero -->
    <Hero
      lang="en"
      title={t.home.hero.title}
      subtitle={t.home.hero.subtitle}
      catNiang={t.catNiang}
    />

    <!-- Featured Products -->
    <section class="py-20 lg:py-32 relative">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
          <div>
            <span class="inline-block mb-3 text-sm font-semibold uppercase tracking-wider text-primary">
              Featured
            </span>
            <h2 class="text-3xl font-bold text-foreground sm:text-4xl">
              {t.home.featuredProducts.title}
            </h2>
            <p class="mt-2 text-muted-foreground max-w-xl">
              {t.home.featuredProducts.subtitle}
            </p>
          </div>
          <a
            href="/en/products"
            class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:gap-3 transition-all"
          >
            {t.home.featuredProducts.viewAll}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 stagger-children">
          {featuredProducts.map((product) => (
            <ProductCard
              image={product.data.images[0] || '/images/placeholder.jpg'}
              title={product.data.name}
              description={product.data.description}
              href={`/en/products/${product.id.replace('en/', '')}`}
              price={product.data.price}
              category={product.data.category}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Latest Posts -->
    <section class="py-20 lg:py-32 bg-muted/50">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
          <div>
            <span class="inline-block mb-3 text-sm font-semibold uppercase tracking-wider text-primary">
              Latest
            </span>
            <h2 class="text-3xl font-bold text-foreground sm:text-4xl">
              {t.home.latestPosts.title}
            </h2>
            <p class="mt-2 text-muted-foreground max-w-xl">
              {t.home.latestPosts.subtitle}
            </p>
          </div>
          <a
            href="/en/blog"
            class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:gap-3 transition-all"
          >
            {t.home.latestPosts.readMore}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 stagger-children">
          {latestPosts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              href={`/en/blog/${post.id.replace('en/', '')}`}
              date={post.data.pubDate}
              tags={post.data.tags}
              coverImage={post.data.coverImage}
            />
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer lang="en" />
</Layout>
