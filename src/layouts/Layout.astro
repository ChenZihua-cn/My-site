---
import '../styles/global.css';
import { SITE } from '../consts';

export interface Props {
  title: string;
  description?: string;
  lang?: 'zh' | 'en';
  /** 绝对或站点根相对路径；缺省则不输出 og:image */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** 该内容实际存在的语言版本（含自身）。缺译本时传单元素数组，避免 hreflang 指向 404 */
  alternateLocales?: Array<'zh' | 'en'>;
  /** JSON-LD，用 src/utils/structured-data.ts 的 graph() 组装 */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description: descriptionProp,
  lang = 'zh',
  image,
  type = 'website',
  noindex = false,
  alternateLocales = ['zh', 'en'],
  jsonLd,
} = Astro.props;

// 页面没显式传描述时，默认描述也要跟随语言，否则中文页会拿到英文 meta description
const description = descriptionProp ?? (lang === 'zh' ? SITE.descriptionZh : SITE.description);

const site = Astro.site ?? new URL(SITE.url);
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = image ? new URL(image, site) : null;

// /zh/... 与 /en/... 的镜像关系用于 hreflang；只有对侧版本真的存在才输出，
// 否则会像 cupt-strategy 那样指向一个 404。无语言前缀的页面不输出。
const localeMatch = /^\/(zh|en)(\/.*)?$/.exec(Astro.url.pathname);
const availableLocales = alternateLocales.filter((locale) => locale === 'zh' || locale === 'en');
const defaultLocale = availableLocales.includes('zh') ? 'zh' : availableLocales[0];
const alternates = localeMatch && availableLocales.length > 1
  ? [
      ...availableLocales.map((locale) => ({
        hreflang: locale === 'zh' ? 'zh-CN' : 'en',
        href: new URL(`/${locale}${localeMatch[2] ?? ''}`, site).href,
      })),
      {
        hreflang: 'x-default',
        href: new URL(`/${defaultLocale}${localeMatch[2] ?? ''}`, site).href,
      },
    ]
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>

    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={lang === 'zh' ? SITE.nameZh : SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    {ogImageURL && <meta property="og:image" content={ogImageURL.href} />}
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL.href} />}
    {alternates.map(({ hreflang, href }) => (
      <link rel="alternate" {hreflang} {href} />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Theme initialization script - runs before page render to prevent flash -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
      />
    )}
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <slot />
  </body>
</html>
