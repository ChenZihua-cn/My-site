<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>luv2u</title>
<script>
  const lang = (navigator.language || (navigator.languages && navigator.languages[0]) || 'en').toLowerCase();
  window.location.replace('/' + (lang.startsWith('zh') ? 'zh' : 'en') + '/');
</script>
</head>
<body>
  <a href="/zh/">中文</a> &nbsp; <a href="/en/">English</a>
</body>
</html>
