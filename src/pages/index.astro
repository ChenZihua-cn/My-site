---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Cyan's Blog — a personal space for tech, thoughts, and exploration" />
  <meta name="robots" content="noindex" />
  <title>Cyan's Blog</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --hue: 250;
      --bg: #030108;
    }

    body {
      background: var(--bg);
      color: #e8e0f0;
      font-family: 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
      cursor: default;
    }

    /* ===== Full-viewport canvas-like background ===== */
    .cosmos {
      position: fixed;
      inset: 0;
      z-index: 0;
      background:
        radial-gradient(ellipse at 50% 50%, oklch(18% 0.04 var(--hue)) 0%, #030108 55%, #010005 100%);
    }

    /* Star layer - two layers for parallax feel */
    .stars-slow, .stars-fast {
      position: absolute;
      inset: -30%;
      background: transparent;
      border-radius: 50%;
    }
    .stars-slow { animation: rotate-slow 300s linear infinite; }
    .stars-fast { animation: rotate-fast 180s linear infinite; }

    @keyframes rotate-slow { to { transform: rotate(360deg); } }
    @keyframes rotate-fast { to { transform: rotate(-360deg); } }

    /* Nebula wisps */
    .nebula {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.15;
      pointer-events: none;
    }
    .nebula-1 {
      width: 60vw; height: 40vw;
      top: -10%; left: -5%;
      background: radial-gradient(ellipse, oklch(40% 0.15 calc(var(--hue) + 60)) 0%, transparent 70%);
    }
    .nebula-2 {
      width: 50vw; height: 35vw;
      bottom: -15%; right: -5%;
      background: radial-gradient(ellipse, oklch(30% 0.12 calc(var(--hue) - 30)) 0%, transparent 70%);
    }
    .nebula-3 {
      width: 30vw; height: 20vw;
      top: 40%; left: 30%;
      background: radial-gradient(ellipse, oklch(35% 0.1 var(--hue)) 0%, transparent 70%);
      animation: nebula-drift 20s ease-in-out infinite;
    }
    @keyframes nebula-drift {
      0%, 100% { transform: translate(0, 0); }
      33% { transform: translate(3vw, -2vw); }
      66% { transform: translate(-2vw, 3vw); }
    }

    /* ===== Black Hole Scene ===== */
    .scene {
      position: relative;
      z-index: 1;
      width: min(420px, 82vw);
      height: min(420px, 82vw);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* ===== The Black Hole ===== */
    .bh-container {
      position: relative;
      width: 100%;
      height: 100%;
    }

    /*
      Gravitational Lensing:
      - The far side of the accretion disk is bent OVER the top
      - The near side is visible in front, below
      - This creates the iconic "halo" effect
    */

    /* --- Far side accretion disk (lensed above the hole) --- */
    .disk-far {
      position: absolute;
      top: 5%; left: 5%; right: 5%; bottom: 28%;
      border-radius: 50% 50% 0 0;
      background: conic-gradient(
        from -15deg,
        oklch(80% 0.16 calc(var(--hue) + 55) / 0.25) 0deg,
        oklch(85% 0.18 calc(var(--hue) + 50) / 0.6) 25deg,
        oklch(92% 0.16 calc(var(--hue) + 45) / 0.9) 50deg,
        oklch(88% 0.17 calc(var(--hue) + 50) / 0.8) 70deg,
        oklch(82% 0.15 calc(var(--hue) + 55) / 0.4) 90deg,
        transparent 120deg,
        transparent 240deg,
        oklch(78% 0.14 calc(var(--hue) + 55) / 0.3) 270deg,
        oklch(88% 0.17 calc(var(--hue) + 48) / 0.7) 300deg,
        oklch(94% 0.16 calc(var(--hue) + 42) / 0.95) 320deg,
        oklch(85% 0.18 calc(var(--hue) + 50) / 0.8) 345deg,
        oklch(80% 0.16 calc(var(--hue) + 55) / 0.25) 360deg
      );
      filter: blur(3px);
      opacity: 0.75;
      z-index: 2;
      animation: disk-wobble 20s ease-in-out infinite;
      clip-path: ellipse(48% 52% at 50% 100%);
    }

    /* Far disk glow */
    .disk-far-glow {
      position: absolute;
      top: 8%; left: 8%; right: 8%; bottom: 32%;
      border-radius: 50% 50% 0 0;
      background: radial-gradient(ellipse at 50% 90%, oklch(75% 0.2 calc(var(--hue) + 50) / 0.3) 0%, transparent 60%);
      filter: blur(15px);
      z-index: 1;
    }

    /* --- Near side accretion disk (in front, below) --- */
    .disk-near {
      position: absolute;
      top: 42%; left: -2%; right: -2%; bottom: -8%;
      border-radius: 0 0 50% 50%;
      background: conic-gradient(
        from 165deg,
        transparent 0deg,
        oklch(75% 0.14 calc(var(--hue) + 55) / 0.2) 15deg,
        oklch(88% 0.17 calc(var(--hue) + 48) / 0.7) 40deg,
        oklch(95% 0.16 calc(var(--hue) + 40) / 0.95) 55deg,
        oklch(92% 0.18 calc(var(--hue) + 45) / 0.9) 65deg,
        oklch(82% 0.15 calc(var(--hue) + 50) / 0.5) 85deg,
        transparent 110deg,
        transparent 250deg,
        oklch(74% 0.13 calc(var(--hue) + 55) / 0.2) 265deg,
        oklch(86% 0.16 calc(var(--hue) + 48) / 0.65) 290deg,
        oklch(94% 0.17 calc(var(--hue) + 42) / 0.9) 310deg,
        oklch(90% 0.17 calc(var(--hue) + 46) / 0.85) 335deg,
        oklch(80% 0.15 calc(var(--hue) + 52) / 0.35) 355deg,
        transparent 360deg
      );
      filter: blur(1.5px);
      opacity: 0.85;
      z-index: 5;
      clip-path: ellipse(52% 48% at 50% 0%);
    }

    /* Near disk bright rim */
    .disk-near-rim {
      position: absolute;
      top: 41%; left: 0%; right: 0%; bottom: -4%;
      border-radius: 0 0 50% 50%;
      border-bottom: 3px solid oklch(92% 0.16 calc(var(--hue) + 45) / 0.7);
      filter: blur(1px);
      z-index: 4;
      clip-path: ellipse(52% 48% at 50% 0%);
    }

    /* --- Einstein ring (gravitational lensing ring) --- */
    .einstein-ring {
      position: absolute;
      inset: 10%;
      border-radius: 50%;
      border: 1.5px solid oklch(75% 0.14 calc(var(--hue) + 50) / 0.35);
      box-shadow:
        0 0 8px oklch(70% 0.18 calc(var(--hue) + 45) / 0.25),
        inset 0 0 6px oklch(75% 0.15 calc(var(--hue) + 50) / 0.2);
      z-index: 3;
      animation: pulse-ring 4s ease-in-out infinite;
    }

    /* --- Event Horizon (the dark center) --- */
    .event-horizon {
      position: absolute;
      inset: 24%;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%,
        oklch(6% 0.02 var(--hue)),
        oklch(3% 0.01 var(--hue)) 40%,
        #000 100%
      );
      box-shadow:
        0 0 30px oklch(55% 0.2 var(--hue) / 0.3),
        0 0 80px oklch(50% 0.18 var(--hue) / 0.18),
        0 0 150px oklch(45% 0.15 var(--hue) / 0.1);
      z-index: 10;
    }

    /* --- Photon ring (thin bright ring just outside event horizon) --- */
    .photon-ring {
      position: absolute;
      inset: 22%;
      border-radius: 50%;
      border: 1.2px solid oklch(85% 0.1 calc(var(--hue) + 40) / 0.5);
      box-shadow:
        0 0 6px oklch(80% 0.12 calc(var(--hue) + 45) / 0.4),
        0 0 20px oklch(75% 0.15 calc(var(--hue) + 45) / 0.2);
      z-index: 11;
      animation: pulse-photon 2.5s ease-in-out infinite;
    }

    /* Inner shadow ring */
    .shadow-ring {
      position: absolute;
      inset: 20%;
      border-radius: 50%;
      border: 4px solid transparent;
      border-top-color: oklch(60% 0.15 var(--hue) / 0.15);
      border-right-color: oklch(60% 0.15 var(--hue) / 0.1);
      z-index: 9;
      filter: blur(4px);
    }

    /* --- Orbiting hot spots --- */
    .orbit-track {
      position: absolute;
      inset: 15%;
      border-radius: 50%;
      z-index: 12;
      animation: spin-orbit 6s linear infinite;
    }
    .orbit-track:nth-child(2) { animation-duration: 9s; animation-direction: reverse; }
    .orbit-track:nth-child(3) { animation-duration: 14s; inset: 12%; }

    .hotspot {
      position: absolute;
      top: -3px;
      left: 50%;
      width: 6px;
      height: 6px;
      margin-left: -3px;
      border-radius: 50%;
      background: oklch(90% 0.12 calc(var(--hue) + 50));
      box-shadow: 0 0 10px oklch(85% 0.15 calc(var(--hue) + 45) / 0.9), 0 0 25px oklch(80% 0.18 calc(var(--hue) + 40) / 0.5);
    }
    .hotspot.bright {
      width: 8px; height: 8px; margin-left: -4px;
      background: oklch(95% 0.1 calc(var(--hue) + 40));
      box-shadow: 0 0 14px oklch(90% 0.14 calc(var(--hue) + 35) / 0.9), 0 0 35px oklch(85% 0.16 calc(var(--hue) + 40) / 0.6);
    }

    @keyframes spin-orbit { to { transform: rotate(360deg); } }
    @keyframes pulse-ring {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 0.7; }
    }
    @keyframes pulse-photon {
      0%, 100% { border-color: oklch(85% 0.1 calc(var(--hue) + 40) / 0.4); }
      50% { border-color: oklch(90% 0.12 calc(var(--hue) + 35) / 0.7); }
    }
    @keyframes disk-wobble {
      0%, 100% { transform: rotate(0deg); }
      33% { transform: rotate(2deg); }
      66% { transform: rotate(-1deg); }
    }

    /* ===== Outer glow aura ===== */
    .aura {
      position: absolute;
      inset: -20%;
      border-radius: 50%;
      background: radial-gradient(circle,
        oklch(55% 0.2 var(--hue) / 0.12) 0%,
        oklch(50% 0.15 var(--hue) / 0.06) 35%,
        transparent 65%
      );
      filter: blur(30px);
      z-index: 0;
      animation: aura-breathe 8s ease-in-out infinite;
    }
    @keyframes aura-breathe {
      0%, 100% { opacity: 0.5; transform: scale(1); }
      50% { opacity: 0.8; transform: scale(1.06); }
    }

    /* ===== Cat floating near hole ===== */
    .space-cat {
      position: absolute;
      z-index: 20;
      font-size: 2.2rem;
      animation: float-cat 6s ease-in-out infinite;
      filter: drop-shadow(0 0 12px oklch(65% 0.18 var(--hue) / 0.5));
      pointer-events: none;
      top: -8%;
      right: -6%;
      opacity: 0.75;
    }
    @keyframes float-cat {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      33% { transform: translateY(-12px) rotate(4deg); }
      66% { transform: translateY(6px) rotate(-3deg); }
    }

    /* ===== Text overlay ===== */
    .overlay {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 30;
      padding: 2rem;
      text-align: center;
      pointer-events: none;
    }

    .site-name {
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      background: linear-gradient(135deg, oklch(85% 0.1 var(--hue)), oklch(95% 0.06 calc(var(--hue) + 25)));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      opacity: 0;
      animation: fade-in-up 0.8s 0.6s ease-out forwards;
    }

    .redirect-line {
      margin-top: 0.7rem;
      font-size: 0.85rem;
      font-weight: 300;
      letter-spacing: 0.04em;
      color: oklch(78% 0.04 var(--hue) / 0.65);
      opacity: 0;
      animation: fade-in 0.6s 1.2s ease-out forwards;
    }

    .countdown-num {
      display: inline-block;
      min-width: 1.2em;
      font-weight: 600;
      color: oklch(85% 0.1 var(--hue));
      transition: color 0.3s;
    }
    .countdown-num.urgent {
      color: oklch(75% 0.18 calc(var(--hue) + 30));
      animation: pulse-urgent 0.6s ease-in-out;
    }

    @keyframes fade-in-up {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes pulse-urgent {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.25); }
    }

    /* ===== Responsive ===== */
    @media (max-width: 480px) {
      .scene { width: 90vw; height: 90vw; }
      .space-cat { font-size: 1.6rem; top: -5%; right: -2%; }
      .site-name { font-size: 1.3rem; }
      .redirect-line { font-size: 0.75rem; }
    }
  </style>
</head>
<body>

  <!-- Cosmos background -->
  <div class="cosmos">
    <div class="stars-slow" id="stars-slow"></div>
    <div class="stars-fast" id="stars-fast"></div>
    <div class="nebula nebula-1"></div>
    <div class="nebula nebula-2"></div>
    <div class="nebula nebula-3"></div>
  </div>

  <!-- Black Hole -->
  <div class="scene">
    <div class="bh-container">
      <!-- Outer aura -->
      <div class="aura"></div>

      <!-- Far side disk (lensed above) -->
      <div class="disk-far-glow"></div>
      <div class="disk-far"></div>

      <!-- Einstein ring -->
      <div class="einstein-ring"></div>

      <!-- Shadow ring -->
      <div class="shadow-ring"></div>

      <!-- Near side disk (in front, below) -->
      <div class="disk-near"></div>
      <div class="disk-near-rim"></div>

      <!-- Event horizon -->
      <div class="event-horizon"></div>

      <!-- Photon ring -->
      <div class="photon-ring"></div>

      <!-- Orbiting hot spots -->
      <div class="orbit-track"><div class="hotspot bright"></div></div>
      <div class="orbit-track"><div class="hotspot"></div></div>
      <div class="orbit-track"><div class="hotspot" style="width:4px;height:4px;top:-2px;margin-left:-2px;"></div></div>

      <!-- Space Cat -->
      <div class="space-cat" aria-hidden="true">🐱</div>
    </div>
  </div>

  <!-- Text overlay -->
  <div class="overlay">
    <div class="site-name">Cyan's Blog</div>
    <p class="redirect-line" id="redirect-zh">正在进入站点… <span class="countdown-num" id="cd-zh">3</span> 秒</p>
    <p class="redirect-line" id="redirect-en" style="display:none;">Entering in <span class="countdown-num" id="cd-en">3</span>s…</p>
  </div>

  <script>
    (function () {
      // ── Generate stars ──
      function makeStars(id, count, sizeRange) {
        const el = document.getElementById(id);
        if (!el) return;
        let shadows = [];
        for (let i = 0; i < count; i++) {
          const x = (Math.random() * 200 - 50).toFixed(1);
          const y = (Math.random() * 200 - 50).toFixed(1);
          const s = (Math.random() * (sizeRange[1] - sizeRange[0]) + sizeRange[0]).toFixed(1);
          const b = (Math.random() * 0.5 + 0.5).toFixed(2);
          shadows.push(`${x}vw ${y}vh ${s}px ${s}px oklch(95% 0.02 var(--hue) / ${b})`);
        }
        el.style.width = '1px';
        el.style.height = '1px';
        el.style.borderRadius = '50%';
        el.style.boxShadow = shadows.join(', ');
      }
      makeStars('stars-slow', 200, [0.8, 2.2]);
      makeStars('stars-fast', 100, [0.5, 1.3]);

      // ── Language detection ──
      const lang = (navigator.language || (navigator.languages && navigator.languages[0]) || 'en').toLowerCase();
      const isZh = lang.startsWith('zh');

      // Show appropriate redirect text
      const zhEl = document.getElementById('redirect-zh');
      const enEl = document.getElementById('redirect-en');
      if (isZh) { if (zhEl) zhEl.style.display = ''; }
      else { if (enEl) enEl.style.display = ''; }

      const targetPath = '/' + (isZh ? 'zh' : 'en') + '/';

      // ── Countdown ──
      let sec = 3;
      const cdZh = document.getElementById('cd-zh');
      const cdEn = document.getElementById('cd-en');
      const cdEl = isZh ? cdZh : cdEn;

      const tick = () => {
        sec--;
        if (cdZh) cdZh.textContent = String(sec);
        if (cdEn) cdEn.textContent = String(sec);

        if (cdEl) {
          cdEl.classList.add('urgent');
          setTimeout(() => cdEl.classList.remove('urgent'), 500);
        }

        if (sec <= 0) {
          window.location.href = targetPath;
        } else {
          setTimeout(tick, 1000);
        }
      };

      setTimeout(tick, 1000);
    })();
  </script>

</body>
</html>
