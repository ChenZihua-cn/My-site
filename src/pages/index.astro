---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Cyan's Blog — a personal space for tech, thoughts, and exploration" />
  <meta name="robots" content="noindex" />
  <title>Cyan's Blog</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --hue: 250;
      --bg: #030108;
    }

    body {
      background: var(--bg);
      color: #e8e0f0;
      font-family: 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
      cursor: default;
    }

    .cosmos {
      position: fixed;
      inset: 0;
      z-index: 0;
      background:
        radial-gradient(ellipse at 50% 50%, oklch(18% 0.04 var(--hue)) 0%, #030108 55%, #010005 100%);
    }

    .stars-slow, .stars-fast {
      position: absolute;
      inset: -30%;
      background: transparent;
      border-radius: 50%;
    }
    .stars-slow { animation: rotate-slow 300s linear infinite; }
    .stars-fast { animation: rotate-fast 180s linear infinite; }

    @keyframes rotate-slow { to { transform: rotate(360deg); } }
    @keyframes rotate-fast { to { transform: rotate(-360deg); } }

    .nebula {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.15;
      pointer-events: none;
    }
    .nebula-1 {
      width: 60vw; height: 40vw;
      top: -10%; left: -5%;
      background: radial-gradient(ellipse, oklch(40% 0.15 calc(var(--hue) + 60)) 0%, transparent 70%);
    }
    .nebula-2 {
      width: 50vw; height: 35vw;
      bottom: -15%; right: -5%;
      background: radial-gradient(ellipse, oklch(30% 0.12 calc(var(--hue) - 30)) 0%, transparent 70%);
    }
    .nebula-3 {
      width: 30vw; height: 20vw;
      top: 40%; left: 30%;
      background: radial-gradient(ellipse, oklch(35% 0.1 var(--hue)) 0%, transparent 70%);
      animation: nebula-drift 20s ease-in-out infinite;
    }
    @keyframes nebula-drift {
      0%, 100% { transform: translate(0, 0); }
      33% { transform: translate(3vw, -2vw); }
      66% { transform: translate(-2vw, 3vw); }
    }

    .scene {
      position: relative;
      z-index: 1;
      width: min(420px, 82vw);
      height: min(420px, 82vw);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .bh-container {
      position: relative;
      width: 100%;
      height: 100%;
    }

    /* --- Far side accretion disk (lensed above) --- */
    .disk-far {
      position: absolute;
      top: 5%; left: 5%; right: 5%; bottom: 28%;
      border-radius: 50% 50% 0 0;
      background: conic-gradient(
        from -15deg,
        oklch(80% 0.16 calc(var(--hue) + 55) / 0.25) 0deg,
        oklch(85% 0.18 calc(var(--hue) + 50) / 0.6) 25deg,
        oklch(92% 0.16 calc(var(--hue) + 45) / 0.9) 50deg,
        oklch(88% 0.17 calc(var(--hue) + 50) / 0.8) 70deg,
        oklch(82% 0.15 calc(var(--hue) + 55) / 0.4) 90deg,
        transparent 120deg,
        transparent 240deg,
        oklch(78% 0.14 calc(var(--hue) + 55) / 0.3) 270deg,
        oklch(88% 0.17 calc(var(--hue) + 48) / 0.7) 300deg,
        oklch(94% 0.16 calc(var(--hue) + 42) / 0.95) 320deg,
        oklch(85% 0.18 calc(var(--hue) + 50) / 0.8) 345deg,
        oklch(80% 0.16 calc(var(--hue) + 55) / 0.25) 360deg
      );
      filter: blur(3px);
      opacity: 0.75;
      z-index: 2;
      animation: disk-wobble 20s ease-in-out infinite;
      clip-path: ellipse(48% 52% at 50% 100%);
    }

    .disk-far-glow {
      position: absolute;
      top: 8%; left: 8%; right: 8%; bottom: 32%;
      border-radius: 50% 50% 0 0;
      background: radial-gradient(ellipse at 50% 90%, oklch(75% 0.2 calc(var(--hue) + 50) / 0.3) 0%, transparent 60%);
      filter: blur(15px);
      z-index: 1;
    }

    /* --- Near side accretion disk (in front, below) --- */
    .disk-near {
      position: absolute;
      top: 42%; left: -2%; right: -2%; bottom: -8%;
      border-radius: 0 0 50% 50%;
      background: conic-gradient(
        from 165deg,
        transparent 0deg,
        oklch(75% 0.14 calc(var(--hue) + 55) / 0.2) 15deg,
        oklch(88% 0.17 calc(var(--hue) + 48) / 0.7) 40deg,
        oklch(95% 0.16 calc(var(--hue) + 40) / 0.95) 55deg,
        oklch(92% 0.18 calc(var(--hue) + 45) / 0.9) 65deg,
        oklch(82% 0.15 calc(var(--hue) + 50) / 0.5) 85deg,
        transparent 110deg,
        transparent 250deg,
        oklch(74% 0.13 calc(var(--hue) + 55) / 0.2) 265deg,
        oklch(86% 0.16 calc(var(--hue) + 48) / 0.65) 290deg,
        oklch(94% 0.17 calc(var(--hue) + 42) / 0.9) 310deg,
        oklch(90% 0.17 calc(var(--hue) + 46) / 0.85) 335deg,
        oklch(80% 0.15 calc(var(--hue) + 52) / 0.35) 355deg,
        transparent 360deg
      );
      filter: blur(1.5px);
      opacity: 0.85;
      z-index: 5;
      clip-path: ellipse(52% 48% at 50% 0%);
    }

    .disk-near-rim {
      position: absolute;
      top: 41%; left: 0%; right: 0%; bottom: -4%;
      border-radius: 0 0 50% 50%;
      border-bottom: 3px solid oklch(92% 0.16 calc(var(--hue) + 45) / 0.7);
      filter: blur(1px);
      z-index: 4;
      clip-path: ellipse(52% 48% at 50% 0%);
    }

    /* --- Einstein ring --- */
    .einstein-ring {
      position: absolute;
      inset: 10%;
      border-radius: 50%;
      border: 1.5px solid oklch(75% 0.14 calc(var(--hue) + 50) / 0.35);
      box-shadow:
        0 0 8px oklch(70% 0.18 calc(var(--hue) + 45) / 0.25),
        inset 0 0 6px oklch(75% 0.15 calc(var(--hue) + 50) / 0.2);
      z-index: 3;
      animation: pulse-ring 4s ease-in-out infinite;
    }

    /* --- Event Horizon --- */
    .event-horizon {
      position: absolute;
      inset: 24%;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%,
        oklch(6% 0.02 var(--hue)),
        oklch(3% 0.01 var(--hue)) 40%,
        #000 100%
      );
      box-shadow:
        0 0 30px oklch(55% 0.2 var(--hue) / 0.3),
        0 0 80px oklch(50% 0.18 var(--hue) / 0.18),
        0 0 150px oklch(45% 0.15 var(--hue) / 0.1);
      z-index: 10;
    }

    /* --- Photon ring --- */
    .photon-ring {
      position: absolute;
      inset: 22%;
      border-radius: 50%;
      border: 1.2px solid oklch(85% 0.1 calc(var(--hue) + 40) / 0.5);
      box-shadow:
        0 0 6px oklch(80% 0.12 calc(var(--hue) + 45) / 0.4),
        0 0 20px oklch(75% 0.15 calc(var(--hue) + 45) / 0.2);
      z-index: 11;
      animation: pulse-photon 2.5s ease-in-out infinite;
    }

    .shadow-ring {
      position: absolute;
      inset: 20%;
      border-radius: 50%;
      border: 4px solid transparent;
      border-top-color: oklch(60% 0.15 var(--hue) / 0.15);
      border-right-color: oklch(60% 0.15 var(--hue) / 0.1);
      z-index: 9;
      filter: blur(4px);
    }

    /* --- Orbiting hot spots --- */
    .orbit-track {
      position: absolute;
      inset: 15%;
      border-radius: 50%;
      z-index: 12;
      animation: spin-orbit 6s linear infinite;
    }
    .orbit-track:nth-child(2) { animation-duration: 9s; animation-direction: reverse; }
    .orbit-track:nth-child(3) { animation-duration: 14s; inset: 12%; }

    .hotspot {
      position: absolute;
      top: -3px;
      left: 50%;
      width: 6px;
      height: 6px;
      margin-left: -3px;
      border-radius: 50%;
      background: oklch(90% 0.12 calc(var(--hue) + 50));
      box-shadow: 0 0 10px oklch(85% 0.15 calc(var(--hue) + 45) / 0.9), 0 0 25px oklch(80% 0.18 calc(var(--hue) + 40) / 0.5);
    }
    .hotspot.bright {
      width: 8px; height: 8px; margin-left: -4px;
      background: oklch(95% 0.1 calc(var(--hue) + 40));
      box-shadow: 0 0 14px oklch(90% 0.14 calc(var(--hue) + 35) / 0.9), 0 0 35px oklch(85% 0.16 calc(var(--hue) + 40) / 0.6);
    }

    @keyframes spin-orbit { to { transform: rotate(360deg); } }
    @keyframes pulse-ring {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 0.7; }
    }
    @keyframes pulse-photon {
      0%, 100% { border-color: oklch(85% 0.1 calc(var(--hue) + 40) / 0.4); }
      50% { border-color: oklch(90% 0.12 calc(var(--hue) + 35) / 0.7); }
    }
    @keyframes disk-wobble {
      0%, 100% { transform: rotate(0deg); }
      33% { transform: rotate(2deg); }
      66% { transform: rotate(-1deg); }
    }

    /* --- Outer glow aura --- */
    .aura {
      position: absolute;
      inset: -20%;
      border-radius: 50%;
      background: radial-gradient(circle,
        oklch(55% 0.2 var(--hue) / 0.12) 0%,
        oklch(50% 0.15 var(--hue) / 0.06) 35%,
        transparent 65%
      );
      filter: blur(30px);
      z-index: 0;
      animation: aura-breathe 8s ease-in-out infinite;
    }
    @keyframes aura-breathe {
      0%, 100% { opacity: 0.5; transform: scale(1); }
      50% { opacity: 0.8; transform: scale(1.06); }
    }

    /* --- Space Cat --- */
    .space-cat {
      position: absolute;
      z-index: 20;
      font-size: 2.2rem;
      animation: float-cat 6s ease-in-out infinite;
      filter: drop-shadow(0 0 12px oklch(65% 0.18 var(--hue) / 0.5));
      pointer-events: none;
      top: -8%;
      right: -6%;
      opacity: 0.75;
    }
    @keyframes float-cat {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      33% { transform: translateY(-12px) rotate(4deg); }
      66% { transform: translateY(6px) rotate(-3deg); }
    }

    /* --- Text overlay --- */
    .overlay {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 30;
      padding: 2rem;
      text-align: center;
      pointer-events: none;
    }

    .site-name {
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      background: linear-gradient(135deg, oklch(85% 0.1 var(--hue)), oklch(95% 0.06 calc(var(--hue) + 25)));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      opacity: 0;
      animation: fade-in-up 0.8s 0.6s ease-out forwards;
    }

    .redirect-line {
      margin-top: 0.7rem;
      font-size: 0.85rem;
      font-weight: 300;
      letter-spacing: 0.04em;
      color: oklch(78% 0.04 var(--hue) / 0.65);
      opacity: 0;
      animation: fade-in 0.6s 1.2s ease-out forwards;
    }

    .countdown-num {
      display: inline-block;
      min-width: 1.2em;
      font-weight: 600;
      color: oklch(85% 0.1 var(--hue));
      transition: color 0.3s;
    }
    .countdown-num.urgent {
      color: oklch(75% 0.18 calc(var(--hue) + 30));
      animation: pulse-urgent 0.6s ease-in-out;
    }

    /* music toggle */
    .music-toggle {
      position: fixed;
      top: 1.2rem;
      right: 1.2rem;
      z-index: 40;
      background: oklch(100% 0.005 var(--hue) / 0.06);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid oklch(100% 0.01 var(--hue) / 0.1);
      border-radius: 2rem;
      color: oklch(85% 0.04 var(--hue) / 0.7);
      padding: 0.5rem 1rem;
      font-size: 0.8rem;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.3s;
      letter-spacing: 0.03em;
    }
    .music-toggle:hover {
      border-color: oklch(100% 0.01 var(--hue) / 0.3);
      color: oklch(95% 0.04 var(--hue) / 0.9);
    }
    .music-toggle.muted {
      opacity: 0.45;
    }

    @keyframes fade-in-up {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes pulse-urgent {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.25); }
    }

    @media (max-width: 480px) {
      .scene { width: 90vw; height: 90vw; }
      .space-cat { font-size: 1.6rem; top: -5%; right: -2%; }
      .site-name { font-size: 1.3rem; }
      .redirect-line { font-size: 0.75rem; }
    }
  </style>
</head>
<body>

  <div class="cosmos">
    <div class="stars-slow" id="stars-slow"></div>
    <div class="stars-fast" id="stars-fast"></div>
    <div class="nebula nebula-1"></div>
    <div class="nebula nebula-2"></div>
    <div class="nebula nebula-3"></div>
  </div>

  <button class="music-toggle" id="music-btn" title="Toggle music">♪ Music</button>

  <div class="scene">
    <div class="bh-container">
      <div class="aura"></div>
      <div class="disk-far-glow"></div>
      <div class="disk-far"></div>
      <div class="einstein-ring"></div>
      <div class="shadow-ring"></div>
      <div class="disk-near"></div>
      <div class="disk-near-rim"></div>
      <div class="event-horizon"></div>
      <div class="photon-ring"></div>
      <div class="orbit-track"><div class="hotspot bright"></div></div>
      <div class="orbit-track"><div class="hotspot"></div></div>
      <div class="orbit-track"><div class="hotspot" style="width:4px;height:4px;top:-2px;margin-left:-2px;"></div></div>
      <div class="space-cat" aria-hidden="true">🐱</div>
    </div>
  </div>

  <div class="overlay">
    <div class="site-name">Cyan's Blog</div>
    <p class="redirect-line" id="redirect-zh">正在进入站点… <span class="countdown-num" id="cd-zh">15</span> 秒</p>
    <p class="redirect-line" id="redirect-en" style="display:none;">Entering in <span class="countdown-num" id="cd-en">15</span>s…</p>
  </div>

  <script>
    (function () {
      // ── Stars ──
      function makeStars(id, count, sizeRange) {
        const el = document.getElementById(id);
        if (!el) return;
        let shadows = [];
        for (let i = 0; i < count; i++) {
          const x = (Math.random() * 200 - 50).toFixed(1);
          const y = (Math.random() * 200 - 50).toFixed(1);
          const s = (Math.random() * (sizeRange[1] - sizeRange[0]) + sizeRange[0]).toFixed(1);
          const b = (Math.random() * 0.5 + 0.5).toFixed(2);
          shadows.push(`${x}vw ${y}vh ${s}px ${s}px oklch(95% 0.02 var(--hue) / ${b})`);
        }
        el.style.width = '1px';
        el.style.height = '1px';
        el.style.borderRadius = '50%';
        el.style.boxShadow = shadows.join(', ');
      }
      makeStars('stars-slow', 200, [0.8, 2.2]);
      makeStars('stars-fast', 100, [0.5, 1.3]);

      // ── Language ──
      const lang = (navigator.language || (navigator.languages && navigator.languages[0]) || 'en').toLowerCase();
      const isZh = lang.startsWith('zh');
      const zhEl = document.getElementById('redirect-zh');
      const enEl = document.getElementById('redirect-en');
      if (isZh) { if (zhEl) zhEl.style.display = ''; }
      else { if (enEl) enEl.style.display = ''; }
      const targetPath = '/' + (isZh ? 'zh' : 'en') + '/';

      // ── Countdown (15s) ──
      let sec = 15;
      const cdZh = document.getElementById('cd-zh');
      const cdEn = document.getElementById('cd-en');
      const cdEl = isZh ? cdZh : cdEn;
      const tick = () => {
        sec--;
        if (cdZh) cdZh.textContent = String(sec);
        if (cdEn) cdEn.textContent = String(sec);
        if (cdEl) {
          cdEl.classList.add('urgent');
          setTimeout(() => cdEl.classList.remove('urgent'), 500);
        }
        if (sec <= 0) { window.location.href = targetPath; }
        else { setTimeout(tick, 1000); }
      };
      setTimeout(tick, 1000);

      // ═══════════════════════════════════════════
      //  8-BIT INTERSTELLAR MUSIC — Web Audio API
      // ═══════════════════════════════════════════
      (function () {
        // wait for user interaction (autoplay policy)
        let ctx: AudioContext | null = null;
        let masterGain: GainNode | null = null;
        let playing = true;

        function initAudio() {
          if (ctx) return;
          ctx = new AudioContext();
          masterGain = ctx.createGain();
          masterGain.gain.value = 0.15;
          masterGain.connect(ctx.destination);
          playInterstellar();
        }

        // Frequency lookup
        const note = (n: string): number => {
          const map: Record<string, number> = {
            'C2':65.41,'D2':73.42,'E2':82.41,'F2':87.31,'G2':98.00,'A2':110.00,'B2':123.47,
            'C3':130.81,'D3':146.83,'E3':164.81,'F3':174.61,'G3':196.00,'A3':220.00,'B3':246.94,
            'C4':261.63,'D4':293.66,'E4':329.63,'F4':349.23,'G4':392.00,'A4':440.00,'B4':493.88,
            'C5':523.25,'D5':587.33,'E5':659.25,'F5':698.46,'G5':783.99,'A5':880.00,'B5':987.77,
            'C6':1046.50
          };
          return map[n] || 440;
        };

        // 8-bit square wave
        function square(ctx: AudioContext, freq: number, start: number, dur: number, vol: number, dest: AudioNode) {
          const osc = ctx.createOscillator();
          osc.type = 'square';
          osc.frequency.value = freq;
          const g = ctx.createGain();
          g.gain.setValueAtTime(0, start);
          g.gain.linearRampToValueAtTime(vol, start + 0.01);
          g.gain.setValueAtTime(vol, start + dur * 0.7);
          g.gain.linearRampToValueAtTime(0, start + dur);
          osc.connect(g);
          g.connect(dest);
          osc.start(start);
          osc.stop(start + dur + 0.01);
        }

        // Triangle wave (softer bass/pad)
        function tri(ctx: AudioContext, freq: number, start: number, dur: number, vol: number, dest: AudioNode) {
          const osc = ctx.createOscillator();
          osc.type = 'triangle';
          osc.frequency.value = freq;
          const g = ctx.createGain();
          g.gain.setValueAtTime(0, start);
          g.gain.linearRampToValueAtTime(vol, start + 0.02);
          g.gain.linearRampToValueAtTime(0, start + dur);
          osc.connect(g);
          g.connect(dest);
          osc.start(start);
          osc.stop(start + dur + 0.01);
        }

        // Noise burst (8-bit drum / tick)
        function noiseTick(ctx: AudioContext, start: number, vol: number, dest: AudioNode) {
          const bufferSize = ctx.sampleRate * 0.015;
          const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) {
            data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);
          }
          const src = ctx.createBufferSource();
          src.buffer = buffer;
          const bp = ctx.createBiquadFilter();
          bp.type = 'highpass';
          bp.frequency.value = 2000;
          const g = ctx.createGain();
          g.gain.setValueAtTime(vol, start);
          g.gain.exponentialRampToValueAtTime(0.0001, start + 0.015);
          src.connect(bp);
          bp.connect(g);
          g.connect(dest);
          src.start(start);
        }

        function playInterstellar() {
          if (!ctx || !masterGain) return;

          // Create a gain node for the melody group (for per-note shaping)
          const melodyBus = ctx.createGain();
          melodyBus.gain.value = 1.0;
          melodyBus.connect(masterGain);

          const padBus = ctx.createGain();
          padBus.gain.value = 0.7;
          padBus.connect(masterGain);

          // ── Interstellar Main Theme (A minor) ──
          // The iconic organ motif adapted to 8-bit:
          // "Cornfield Chase" style rising pattern + "STAY" resolution

          // Notes for the melody sequence (inspired by Hans Zimmer)
          // Pattern: A3 E4 A4 E4 | F4 C5 F4 C5 | A3 E4 A4 B4 | C5 B4 A4 E4
          // Each note = [noteName, duration in beats, velocity]
          const bpm = 76;
          const beat = 60 / bpm; // seconds per beat
          const bar = beat * 4;

          const melody: [string, number, number][] = [
            // Bar 1 — rising tension (Cornfield Chase)
            ['A3', 2, 0.35], ['E4', 1, 0.4], ['A4', 1, 0.45],
            ['E4', 1, 0.35], ['A4', 1, 0.4], ['B4', 1, 0.5], ['C5', 1, 0.6],
            // Bar 2
            ['B4', 2, 0.45], ['A4', 1, 0.35], ['E4', 1, 0.3],
            ['G4', 2, 0.4], ['A4', 2, 0.5],
            // Bar 3 — the "STAY" theme
            ['A4', 2, 0.55], ['G4', 1, 0.4], ['E4', 1, 0.35],
            ['C4', 2, 0.4], ['E4', 1, 0.3], ['G4', 1, 0.35],
            // Bar 4 — resolution
            ['A4', 3, 0.5], ['E4', 1, 0.3],
            ['D4', 2, 0.35], ['E4', 2, 0.3],
            // Bar 5 — repeat rising with variation
            ['A3', 1.5, 0.35], ['E4', 0.5, 0.35], ['A4', 1, 0.45],
            ['E4', 1, 0.35], ['F4', 0.5, 0.4], ['G4', 0.5, 0.4],
            ['A4', 1, 0.5], ['B4', 0.5, 0.55], ['C5', 0.5, 0.55],
            // Bar 6
            ['B4', 1, 0.45], ['A4', 1, 0.4], ['G4', 1, 0.35],
            ['E4', 2, 0.3], ['D4', 1, 0.3], ['C4', 1, 0.25],
            // Bar 7 — final ascent
            ['A3', 1, 0.3], ['C4', 1, 0.3], ['E4', 1, 0.35],
            ['A4', 2, 0.5], ['G4', 1, 0.4],
            ['E4', 1.5, 0.3], ['D4', 0.5, 0.25],
            // Bar 8 — close
            ['E4', 3, 0.45], ['A4', 1, 0.5],
            ['C5', 2, 0.6], ['B4', 2, 0.4],
          ];

          // ── Bass/Pad — slow organ-like chords ──
          const pad: [string, number, number][] = [
            ['A2', bar * 4, 0.15],
            ['F2', bar * 4, 0.13],
            ['C3', bar * 4, 0.14],
            ['E2', bar * 2, 0.12], ['D2', bar * 2, 0.12],
            ['A2', bar * 4, 0.15],
            ['F2', bar * 4, 0.13],
            ['A2', bar * 4, 0.16],
            ['E2', bar * 2, 0.14], ['A2', bar * 2, 0.15],
          ];

          const loopDur = bar * 8; // 8 bars total

          function scheduleLoop(time: number) {
            if (!ctx || !masterGain || !playing) return;

            // Schedule melody
            let mTime = time;
            for (const [n, dur, vol] of melody) {
              const noteLen = dur * beat;
              square(ctx, note(n), mTime, noteLen * 0.85, vol * 0.7, melodyBus);
              mTime += noteLen;
            }

            // Schedule pad
            let pTime = time;
            for (const [n, dur, vol] of pad) {
              const noteLen = dur;
              tri(ctx, note(n), pTime, noteLen * 0.95, vol * 0.6, padBus);
              pTime += noteLen;
            }

            // Tick sound (the Interstellar clock motif) — every quarter note
            for (let t = 0; t < loopDur; t += beat) {
              // Louder ticks every bar
              const isBar = Math.abs(t % bar) < 0.001;
              noiseTick(ctx, time + t, isBar ? 0.09 : 0.04, masterGain);
            }

            // Schedule next loop
            const nextLoop = time + loopDur;
            const scheduleAt = nextLoop - 0.5;
            const now = ctx.currentTime;
            const delay = Math.max(0.1, (scheduleAt - now) * 1000);
            setTimeout(() => scheduleLoop(nextLoop), delay);
          }

          // Start at next beat boundary
          const now = ctx.currentTime;
          const startTime = now + 0.1;
          scheduleLoop(startTime);
        }

        // ── Music toggle button ──
        const btn = document.getElementById('music-btn');
        btn?.addEventListener('click', () => {
          if (!ctx) { initAudio(); btn.classList.remove('muted'); return; }
          playing = !playing;
          if (masterGain) {
            masterGain.gain.linearRampToValueAtTime(playing ? 0.15 : 0, ctx.currentTime + 0.1);
          }
          btn.classList.toggle('muted', !playing);
        });

        // Auto-start on first interaction
        document.addEventListener('click', initAudio, { once: true });
        document.addEventListener('keydown', initAudio, { once: true });
      })();
    })();
  </script>

</body>
</html>
